# TEMPLATE ONLY — never put real keys in this file; it is committed to git.
# Copy to backend/.env (gitignored) and fill values there.
# === AI (open-weight models) ===
# "openrouter" = hosted open-weight models (free tier available)
# "ollama"     = local inference on this machine
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# === Local inference (Ollama) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Only for Ollama cloud models:
#   OLLAMA_BASE_URL=https://ollama.com
#   OLLAMA_MODEL=gemma4:31b   (use the exact model name, not the ":cloud" CLI alias)
#   OLLAMA_API_KEY=<key from https://ollama.com/settings/keys>
OLLAMA_API_KEY=

# === GitHub OAuth (optional) ===
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: token used for public repo analysis. Anonymous GitHub API calls are
# limited to 60/hour; a token raises that to 5,000/hour. A classic PAT with no
# scopes (or a fine-grained token with "Public repositories: Read") is enough.
GITHUB_TOKEN=

# === Notion (optional) ===
NOTION_TOKEN=

# === Neo4j AuraDB (optional — in-memory used otherwise) ===
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# === Auth ===
JWT_SECRET=your-secret-here

# === Demo Mode ===
# Set to true to run with mock data (no API keys needed)
DEMO_MODE=false

# === Frontend API URL ===
NEXT_PUBLIC_API_URL=http://localhost:8000
OPENROUTER_FALLBACK_MODELS=xingchen-agi/xing4.0-29b-a4b:free,liquid/lfm-2.5-2.6b:free
